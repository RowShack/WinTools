<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WifiRoamLog</AssemblyName>
    <RootNamespace>WifiRoamLog</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <!-- Runs as a normal user: reading Wi-Fi state and pinging need no administrator rights. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\WifiRoamLog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

</Project>
